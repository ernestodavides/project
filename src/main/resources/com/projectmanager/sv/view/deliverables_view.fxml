<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.projectmanager.sv.controller.DeliverableController"
      spacing="8" style="-fx-padding: 10;">
    <HBox alignment="CENTER_LEFT" spacing="8">
        <Label text="Proyecto:" style="-fx-font-weight: bold;"/>
        <ComboBox fx:id="projectSelector" promptText="Seleccione un proyecto" prefWidth="320"/>
    </HBox>
    <SplitPane dividerPositions="0.52" VBox.vgrow="ALWAYS">
        <VBox spacing="8" style="-fx-padding: 10;">
            <HBox alignment="CENTER_LEFT" spacing="6">
                <Label text="Entregables del proyecto" style="-fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="deleteDeliverableButton" text="Eliminar" onAction="#handleDeleteDeliverable"/>
                <Button fx:id="addDeliverableButton" text="+ Agregar entregable" onAction="#handleAddDeliverable"/>
            </HBox>
            <TableView fx:id="deliverablesTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colDeliverableName" text="Nombre" prefWidth="150"/>
                    <TableColumn fx:id="colDeliverableGoal" text="Objetivo" prefWidth="190"/>
                    <TableColumn fx:id="colDeliverableProgress" text="Avance" prefWidth="170"/>
                    <TableColumn fx:id="colDeliverableEndDate" text="Finaliza" prefWidth="110"/>
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            </TableView>
        </VBox>
        <VBox spacing="8" style="-fx-padding: 10;">
            <HBox alignment="CENTER_LEFT" spacing="6">
                <Label fx:id="selectedDeliverableLabel" text="Tareas (seleccione un entregable)" style="-fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="updateTaskProgressButton" text="Actualizar %" onAction="#handleUpdateTaskProgress"/>
                <Button fx:id="deleteTaskButton" text="Eliminar" onAction="#handleDeleteTask"/>
                <Button fx:id="addTaskButton" text="+ Agregar tarea" onAction="#handleAddTask"/>
            </HBox>
            <TableView fx:id="deliverableTasksTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colTaskTitle" text="Tarea" prefWidth="170"/>
                    <TableColumn fx:id="colTaskSprint" text="Sprint" prefWidth="90"/>
                    <TableColumn fx:id="colTaskProgress" text="Avance" prefWidth="165"/>
                    <TableColumn fx:id="colTaskEndDate" text="Finaliza" prefWidth="110"/>
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            </TableView>
        </VBox>
    </SplitPane>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<SplitPane xmlns="http://javafx.com/javafx/25"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.projectmanager.sv.controller.SprintController"
           dividerPositions="0.40">
    <VBox spacing="8" style="-fx-padding: 10;">
        <HBox alignment="CENTER_LEFT">
            <Label text="Sprints de trabajo" style="-fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="editSprintButton" text="Editar" onAction="#handleEditSprint"/>
            <Button fx:id="deleteSprintButton" text="Eliminar" onAction="#handleDeleteSprint"/>
            <Button fx:id="addSprintButton" text="+ Nuevo sprint" onAction="#handleAddSprint"/>
        </HBox>
        <TableView fx:id="sprintsTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colSprintNumber" text="Sprint" prefWidth="95"/>
                <TableColumn fx:id="colSprintStartDate" text="Fecha de inicio" prefWidth="110"/>
                <TableColumn fx:id="colSprintEndDate" text="Fecha de fin" prefWidth="110"/>
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        </TableView>
    </VBox>
    <VBox spacing="8" style="-fx-padding: 10;">
        <HBox alignment="CENTER_LEFT">
            <Label fx:id="selectedSprintTasksLabel" text="Tareas de todos los proyectos del sprint" style="-fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="updateSprintTaskProgressButton" text="Actualizar avance de tarea" onAction="#handleUpdateSprintTaskProgress"/>
        </HBox>
        <TableView fx:id="sprintTasksTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colSprintTaskProject" text="Proyecto" prefWidth="140"/>
                <TableColumn fx:id="colSprintTaskDeliverable" text="Entregable" prefWidth="140"/>
                <TableColumn fx:id="colSprintTaskTitle" text="Tarea" prefWidth="180"/>
                <TableColumn fx:id="colSprintTaskProgress" text="Avance" prefWidth="165"/>
                <TableColumn fx:id="colSprintTaskEndDate" text="Finaliza" prefWidth="110"/>
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        </TableView>
    </VBox>
</SplitPane>

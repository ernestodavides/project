<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.projectmanager.sv.controller.ProjectController"
      spacing="14" style="-fx-padding: 18;">
    <HBox alignment="CENTER_LEFT">
        <VBox spacing="2">
            <Label text="Administrar proyectos" style="-fx-font-size: 21px; -fx-font-weight: bold;"/>
            <Label text="Cree, edite o elimine proyectos."/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox spacing="8">
            <Button fx:id="editProjectButton" text="Editar seleccionado" onAction="#handleEditProject"/>
            <Button fx:id="deleteProjectButton" text="Eliminar" onAction="#handleDeleteProject"/>
            <Button text="+ Nuevo proyecto" onAction="#handleNewProject"/>
        </HBox>
    </HBox>
    <TableView fx:id="projectsTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colProjectTitle" text="Título" prefWidth="280"/>
            <TableColumn fx:id="colProjectMission" text="Misión" prefWidth="180"/>
            <TableColumn fx:id="colProjectProgress" text="Avance global" prefWidth="170"/>
            <TableColumn fx:id="colProjectStartDate" text="Fecha de inicio" prefWidth="110"/>
            <TableColumn fx:id="colProjectEndDate" text="Fecha de fin" prefWidth="110"/>
        </columns>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
    </TableView>
</VBox>
